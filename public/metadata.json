{
  "id": "tinted",
  "name": "Tinted",
  "version": "0.3.0",
  "authors": ["CCBlueX"],
  "screens": ["title", "clickgui", "multiplayer", "singleplayer", "altmanager", "proxymanager", "viafabricplus_protocol_selection"],
  "overlays": ["hud", "game_menu", "disconnected", "inventory", "container", "browser", "basicmenu"],
  "splash": { "animation": "splash/animation.json", "background": "#10131a", "text": "#ffffff", "accent": "#4677ff" },
  "components": ["Island", "Modules", "Scoreboard", "Armor", "Effects", "Target"],
  "fonts": [],
  "backgrounds": [],
  "values": [
    {
      "type": "CONFIGURABLE",
      "name": "Accessibility",
      "values": [
        { "type": "CHOOSE", "name": "ReduceMotion", "value": "Auto", "choices": ["Auto", "On", "Off"] },
        { "type": "BOOLEAN", "name": "ReduceSound", "value": false },
        { "type": "CHOOSE", "name": "IncreaseContrast", "value": "Auto", "choices": ["Auto", "On", "Off"] },
        { "type": "BOOLEAN", "name": "ReduceTransparency", "value": false },
        { "type": "BOOLEAN", "name": "SoundCaptions", "value": false },
        { "type": "FLOAT", "name": "Scale", "value": 1.0, "range": { "min": 0.85, "max": 1.5 }, "suffix": "x" }
      ]
    },
    {
      "type": "CONFIGURABLE",
      "name": "Sound",
      "values": [
        { "type": "INT", "name": "Volume", "value": 60, "range": { "min": 0, "max": 100 }, "suffix": "%" }
      ]
    },
    {
      "type": "CONFIGURABLE",
      "name": "ModuleList",
      "values": [
        { "type": "CHOOSE", "name": "Show", "value": "Toggled", "choices": ["Toggled", "Bound", "All"] },
        { "type": "BOOLEAN", "name": "BindsWhenOff", "value": true },
        { "type": "INT", "name": "MaxRows", "value": 12, "range": { "min": 3, "max": 40 } }
      ]
    }
  ]
}
